# =====================================================
# MenuGreen System - Production Environment Template
# =====================================================
# Copy this file to .env on the production server.
# NEVER commit real secrets or production values here.
# Manage secrets via Doppler / GitHub Secrets / CI pipeline.
# =====================================================

# -----------------------------------------------------
# Database Connection (AWS RDS PostgreSQL)
# -----------------------------------------------------
DB_HOST=<RDS_ENDPOINT>
DB_PORT=5432
DB_NAME=MenuGreenDb
DB_USER=postgres
DB_PASSWORD=<DB_PASSWORD>
DB_SSL_MODE=Require
DB_TRUST_SERVER_CERTIFICATE=true

# -----------------------------------------------------
# Redis (Docker Container)
# Use simple password without special chars: $, !, #
# -----------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>

# -----------------------------------------------------
# API Settings
# -----------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=5000
ASPNETCORE_METRICS=true

# -----------------------------------------------------
# CORS (comma-separated allowed origins)
# Example: https://menugreen.app,https://admin.menugreen.app
# -----------------------------------------------------
ALLOWED_ORIGINS=https://your-frontend-domain.example.com,https://admin.your-frontend-domain.example.com

# -----------------------------------------------------
# JWT / Authentication
# Generate a strong random key (min 32 chars):
#   openssl rand -base64 48
# -----------------------------------------------------
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECURE_KEY_AT_LEAST_32_CHARS
JWT_EXPIRY_MINUTES=1440

# -----------------------------------------------------
# CV Service (optional)
# -----------------------------------------------------
CV_SERVICE_BASE_URL=https://cv-service.your-domain.com
CV_SERVICE_API_SECRET_KEY=CHANGE_THIS_IF_USING_CV_SERVICE
