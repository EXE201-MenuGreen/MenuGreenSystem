# =====================================================
# MenuGreen System - Production Environment Template
# =====================================================
# Production secrets are managed via Doppler.
# This file documents the expected environment variables.
# See: docs/01-deployment/ for Doppler setup guide.
# =====================================================

# -----------------------------------------------------
# Database Connection (AWS RDS PostgreSQL)
# Values from Doppler: DOPPLER_CONFIG
# -----------------------------------------------------
DB_HOST=<RDS_ENDPOINT>
DB_PORT=5432
DB_NAME=MenuGreenDb
DB_USER=postgres
DB_PASSWORD=<from Doppler>
DB_SSL_MODE=Require
DB_TRUST_SERVER_CERTIFICATE=true

# -----------------------------------------------------
# Redis (Docker Container)
# Simple password without special chars: $, !, #
# -----------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<from Doppler>

# -----------------------------------------------------
# API Settings
# -----------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=5000
ASPNETCORE_METRICS=true
METRICS_AUTH_TOKEN=<from Doppler>
TRUST_PROXY_HEADERS=true
ENABLE_SWAGGER=false

# -----------------------------------------------------
# CORS (comma-separated allowed origins)
# -----------------------------------------------------
ALLOWED_ORIGINS=https://admin.menugreen.food,https://www.menugreen.food,https://menugreen.food

# -----------------------------------------------------
# JWT / Authentication
# Generate a strong random key:
#   openssl rand -base64 48
# -----------------------------------------------------
JWT_SECRET_KEY=<from Doppler>
JwtSettings__Issuer=MenuGreenAPI
JwtSettings__Audience=MenuGreenClient
JwtSettings__ExpiryMinutes=60

# -----------------------------------------------------
# CV Service (optional)
# -----------------------------------------------------
CV_SERVICE_BASE_URL=
CV_SERVICE_API_SECRET_KEY=

# -----------------------------------------------------
# Server-side integrations
# -----------------------------------------------------
RESEND_API_KEY=<from Doppler>
GOONG_API_KEY=<from Doppler>
SePay__WebhookAuthMode=HmacSha256
SePay__WebhookSecret=<from Doppler>
Firebase__CredentialPath=/etc/secrets/firebase-adminsdk.json
