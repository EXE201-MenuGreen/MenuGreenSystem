# =====================================================
# MenuGreen System - Production Environment Template
# =====================================================
# Copy this file to .env on the production server
# NEVER commit .env to version control
# =====================================================

# -----------------------------------------------------
# PostgreSQL
# -----------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION
POSTGRES_DB=MenuGreenDb

# -----------------------------------------------------
# Database Connection
# Production: use RDS endpoint or container hostname
# -----------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=MenuGreenDb
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION
DB_SSL_MODE=Require
DB_TRUST_SERVER_CERTIFICATE=true

# -----------------------------------------------------
# Redis
# -----------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# -----------------------------------------------------
# API Settings
# -----------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=5000
ASPNETCORE_METRICS=true

# -----------------------------------------------------
# CORS (comma-separated allowed origins)
# Example: https://menugreen.app,https://admin.menugreen.app
# -----------------------------------------------------
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# -----------------------------------------------------
# JWT / Authentication
# Generate a strong random key (min 32 chars)
# -----------------------------------------------------
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECURE_KEY_AT_LEAST_32_CHARS
JWT_EXPIRY_MINUTES=1440

# -----------------------------------------------------
# CV Service (optional)
# -----------------------------------------------------
CV_SERVICE_BASE_URL=https://cv-service.your-domain.com
CV_SERVICE_API_SECRET_KEY=CHANGE_THIS

# -----------------------------------------------------
# Monitoring - Grafana
# -----------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD
GF_USERS_ALLOW_SIGN_UP=false
GF_INSTALL_PLUGINS=grafana-clock-panel

# -----------------------------------------------------
# Monitoring - Nginx Basic Auth
# -----------------------------------------------------
NGINX_BASIC_AUTH_USER=admin
NGINX_BASIC_AUTH_PASSWORD=CHANGE_THIS_NGINX_PASSWORD
