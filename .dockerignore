# Git
.git
.gitignore

# IDE
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build outputs - tránh conflict với build trong container
**/bin/
**/obj/
**/out/

# Test
**/*[Tt]est*
**/__[Tt]ests__/
*.TestResults*
*.trx

# Documentation - giữ license files
*.md
docs/
!docs/THIRD-PARTY-LICENSES
!LICENSE

# Docker files (tránh recursion trong build context)
# Chỉ ignore Dockerfile trong các thư mục con, KHÔNG ignore ở root
**/Dockerfile*
!.dockerignore

# Secrets & Config local
**/.env
**/.env.*
**/appsettings.*.local.json
**/secrets.json

# Logs
*.log
logs/
**/logs/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Frontend (không cần cho backend container)
frontend/
frontend-web/
**/node_modules/
!.github/

# CI/CD - không cần trong production image
.github/workflows/
scripts/

# Temporary files
*.tmp
*.temp
*.swp
*.bak

# Certificates & keys (trừ các file có thể cần cho prod)
*.pfx
*.pem
*.key
*.crt
!**/certs/
