# =====================================================
# MenuGreen System - Environment Variables Template
# =====================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# =====================================================

# -----------------------------------------------------
# PostgreSQL (local container)
# Used when DB_HOST=localhost or DB_HOST=db
# -----------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_postgres_password_here
POSTGRES_DB=MenuGreenDb

# -----------------------------------------------------
# Database Connection
# - For local Docker DB:  DB_HOST=db or DB_HOST=localhost
# - For AWS RDS:         DB_HOST=ls-xxxx.ap-southeast-1.rds.amazonaws.com
# -----------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=MenuGreenDb
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_SSL_MODE=Require
DB_TRUST_SERVER_CERTIFICATE=true

# -----------------------------------------------------
# Redis
# -----------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# -----------------------------------------------------
# API Settings
# -----------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=5000
ASPNETCORE_METRICS=true

# -----------------------------------------------------
# CORS (development)
# -----------------------------------------------------
ALLOWED_ORIGINS=*

# -----------------------------------------------------
# JWT / Authentication (local dev only)
# -----------------------------------------------------
JWT_SECRET_KEY=dev_secret_key_please_change_in_production_12345
JWT_EXPIRY_MINUTES=1440

# -----------------------------------------------------
# CV Service (optional - set URL if using CV service)
# -----------------------------------------------------
CV_SERVICE_BASE_URL=http://cv-service:8000
CV_SERVICE_API_SECRET_KEY=

# -----------------------------------------------------
# Grafana
# -----------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password_here
GF_USERS_ALLOW_SIGN_UP=false
GF_INSTALL_PLUGINS=grafana-clock-panel

# -----------------------------------------------------
# Nginx Basic Auth (monitoring/nginx/.htpasswd)
# Generate with: htpasswd -bc monitoring/nginx/.htpasswd admin your_password
# -----------------------------------------------------
NGINX_BASIC_AUTH_USER=admin
NGINX_BASIC_AUTH_PASSWORD=your_nginx_password_here
