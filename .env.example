# =====================================================
# MenuGreen System - Environment Variables Template
# =====================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# =====================================================

# -----------------------------------------------------
# Database Connection (Local Docker)
# DB_HOST=db (Docker service name)
# DB_HOST=localhost (if not using Docker)
# -----------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=MenuGreenDb
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_SSL_MODE=Disable
DB_TRUST_SERVER_CERTIFICATE=true

# -----------------------------------------------------
# Redis (Docker container)
# -----------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# -----------------------------------------------------
# API Settings
# -----------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=5000

# -----------------------------------------------------
# CORS (development - allow all)
# -----------------------------------------------------
ALLOWED_ORIGINS=*

# -----------------------------------------------------
# JWT / Authentication
# Generate a secure key:
#   openssl rand -base64 48
# -----------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_random_secure_key_at_least_32_chars
JWT_EXPIRY_MINUTES=1440

# -----------------------------------------------------
# CV Service (optional)
# -----------------------------------------------------
CV_SERVICE_BASE_URL=
CV_SERVICE_API_SECRET_KEY=
