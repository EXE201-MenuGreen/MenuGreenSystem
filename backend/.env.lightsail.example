# =====================================================
# MenuGreen System - Lightsail Production Environment Template
# =====================================================
# Copy this file to .env and fill in your actual values.
# This is a TEMPLATE only. Do NOT commit real secrets here.
# =====================================================

# -----------------------------------------------------
# API Server
# -----------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http+:5000

# -----------------------------------------------------
# Database (AWS RDS)
# -----------------------------------------------------
# ConnectionStrings__DefaultConnection format:
# Host=<RDS_ENDPOINT>;Port=5432;Database=MenuGreenDb;Username=<DB_USER>;Password=<DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=Host=<RDS_ENDPOINT>;Port=5432;Database=MenuGreenDb;Username=<DB_USER>;Password=<DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# -----------------------------------------------------
# Redis (Docker container local on Lightsail)
# -----------------------------------------------------
# Backend reads in this order: Redis:ConnectionString > ConnectionStrings:Redis > REDIS_URL
Redis__ConnectionString=<REDIS_CONNECTION_STRING>
ConnectionStrings__Redis=<REDIS_CONNECTION_STRING>
REDIS_URL=<REDIS_CONNECTION_STRING>
# Example: REDIS_CONNECTION_STRING=localhost:6379,password=<password>

# -----------------------------------------------------
# CORS
# -----------------------------------------------------
AllowedOrigins=https://menugreen.vn,https://app.menugreen.vn

# -----------------------------------------------------
# JWT / Authentication
# -----------------------------------------------------
# Generate a secure random key (min 32 chars):
# openssl rand -base64 48
JwtSettings__SecretKey=<JWT_SECRET_KEY>
JwtSettings__Issuer=MenuGreenAPI
JwtSettings__Audience=MenuGreenClient
JwtSettings__ExpiryMinutes=120

# -----------------------------------------------------
# Email (Resend)
# -----------------------------------------------------
Resend__ApiKey=<RESEND_API_KEY>
Resend__FromEmail=noreply@menugreen.food
Resend__FromName=MenuGreen

# -----------------------------------------------------
# SePay Payment
# -----------------------------------------------------
SePay__WebhookApiKey=<SEPAY_WEBHOOK_API_KEY>
SePay__WebhookSecret=<SEPAY_WEBHOOK_SECRET>
SePay__WebhookAuthMode=HmacSha256
SePay__WebhookTimestampToleranceSeconds=300
SePay__PaymentCodePrefix=DH
SePay__PaymentCodeSuffixLength=8
SePay__PaymentCodeSuffixMinLength=3
SePay__PaymentCodeSuffixMaxLength=10
SePay__OrderExpiryMinutes=30
SePay__QrImageBaseUrl=https://qr.sepay.vn/img
SePay__BankAccount__AccountNumber=<SEPAY_BANK_ACCOUNT_NUMBER>
SePay__BankAccount__BankName=<SEPAY_BANK_NAME>
SePay__BankAccount__AccountHolderName=<SEPAY_ACCOUNT_HOLDER_NAME>
SePay__BankAccount__TransferDescriptionPrefix=<SEPAY_TRANSFER_DESCRIPTION_PREFIX>
SePay__ApiKey=<SEPAY_API_KEY>
SePay__StatusCacheSeconds=4
SePay__AutoApprovePendingInDev=false

# -----------------------------------------------------
# Firebase Cloud Messaging (FCM)
# -----------------------------------------------------
Firebase__CredentialPath=/etc/secrets/firebase-adminsdk.json
Firebase__Enabled=true

# -----------------------------------------------------
# CV Service (optional)
# -----------------------------------------------------
CvService__BaseUrl=<CV_SERVICE_BASE_URL>
CvService__ApiSecretKey=<CV_SERVICE_API_SECRET_KEY>

# -----------------------------------------------------
# AI/Nutrition Assistant (optional)
# -----------------------------------------------------
NutritionAssistant__WorkerUrl=<NUTRITION_ASSISTANT_WORKER_URL>

# -----------------------------------------------------
# AI Gemini (optional)
# -----------------------------------------------------
Ai__GeminiApiKey=<GEMINI_API_KEY>
Ai__ModelName=

# -----------------------------------------------------
# GitHub Actions - Deployment
# -----------------------------------------------------
# CI/CD will inject these secrets via GitHub Secrets / Doppler.
# Do NOT hardcode real values in this template file.
# LIGHTSAIL_HOST=<LIGHTSAIL_HOST>
# LIGHTSAIL_USER=<LIGHTSAIL_USER>
# LIGHTSAIL_SSH_KEY=<LIGHTSAIL_SSH_KEY>
