// Copy nội dung này vào Firebase Console → Storage → Rules → Publish
// Dev/demo: app chưa dùng Firebase Auth (chỉ JWT backend).

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if fileName == 'avatar.jpg'
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if fileName == 'avatar.jpg';
    }

    // Dev/demo only: coach accounts are authenticated by the backend JWT,
    // which Firebase Storage Rules cannot validate directly.
    match /coach-applications/{userId}/{category}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }
  }
}

// Nếu vẫn bị permission-denied, dùng tạm (chỉ dev):
//   allow read, write: if true;
